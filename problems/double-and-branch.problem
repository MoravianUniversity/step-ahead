id: double-and-branch
title: Double and branch
description: Predict each step: advancing through lines, calling double, returning, and taking a branch.

[random]
n = 1..3
fn ~ double twice scale
arg, result ~ n x value num total
y, z ~ a b c d e

[code]
def $fn($arg):
    """
    Doubles a number.
    """
    $result = 0
    # Double the number n times.
    for i in range($arg):
        print(i)
        $result += 2
    return $result


def main():
    $arg = $n
    $y = $fn($arg)
    if $y > 1:
        $z = $y + 1
    else:
        $z = 0
    print($z)


if __name__ == "__main__":
    main()
