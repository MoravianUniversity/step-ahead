id: helper-cascade
title: Helper cascade
description: Trace a cascade of helper calls and two separate print statements.

[random]
xv = 2..4
yv = 1..3
fa, fb ~ a b f g h p q
px, py, vx, vy ~ x y z m n u v w

[code]
def $fa($px, $py):
    $py = 2*$px
    return $py + $px

def $fb($px):
    return $fa(1, $px)

def main():
    $vx = $xv
    $vy = $yv
    $vx = $fa($fb($vx), $vy) + $fb($vy)
    print($vx)
    print($vy)

if __name__ == "__main__":
    main()
