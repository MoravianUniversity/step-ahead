id: conditionals-mastery
title: Conditionals Mastery
order: 80
description: Trace if/elif/fall-through returns inside a helper, called with nested or compound arguments — names and structure vary each run.

[setup]
# Intermediates use leading _ so only `code` becomes a $slot.
_VAR_NAMES_SHORT = ("a", "b", "c", "x", "y", "z")
_VAR_NAMES_LONG = ("foo", "bar", "baz", "qux")

_func = random.choice(_VAR_NAMES_LONG)
_var1, _var2 = random.sample(_VAR_NAMES_SHORT, 2)
_nums = random.sample(range(0, 10), 6)
_returns = random.sample([_var1, _var2, "-1"], 3)

_main_code_1 = f"{_var2} = {_func}({_nums[0]}, {_nums[1]})"
_nums = _nums[2:]
_main_code_2 = random.choice([
    f"{_var1} = {_func}({_func}({_nums[0]}, {_nums[1]}), {_nums[2]})",
    f"{_var1} = {_func}({_nums[0]}, {_func}({_nums[1]}, {_nums[2]}))",
    f"{_var1} = {_func}({_nums[0]}, {_nums[1]}) + {_func}({_nums[2]}, {_nums[3]})",
    f"{_var1} = {_func}({_var2}, {_nums[0]})",
    f"{_var1} = {_func}({_nums[0]}, {_var2})",
])
_print_code = f'print("{_var1}", {_var1}, "{_var2}", {_var2})'

_cond1 = f"{_var1} > {random.randint(1, 5)}"
_cond2 = f"{_var2} < {random.randint(5, 10)}"

if _returns[0] == "-1" and random.choice([True, False]):
    _returns = [f"{_returns[2]} = {_returns[1]}", f"return {_returns[1]}", f"return {_returns[2]}"]
elif _returns[1] == "-1" and random.choice([True, False]):
    _returns = [f"return {_returns[0]}", f"{_returns[2]} = {_returns[0]}", f"return {_returns[2]}"]
else:
    _returns = [f"return {r}" for r in _returns]

code = f"""def {_func}({_var1}, {_var2}):
    if {_cond1}:
        {_returns[0]}
    elif {_cond2}:
        {_returns[1]}
    {_returns[2]}

def main():
    {_main_code_1}
    {_main_code_2}
    {_print_code}

if __name__ == "__main__":
    main()
"""

[code]
$code
